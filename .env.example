# ARES - Environment Variables Template
# Copy this file to .env and fill in your values

# ===========================================
# TELEGRAM
# ===========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ===========================================
# AI PROVIDERS
# ===========================================
# Groq API (principal - rápido)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter API (fallback - modelos gratuitos)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# ===========================================
# DATABASE (TiDB Cloud)
# ===========================================
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=test

# ===========================================
# SECURITY
# ===========================================
# API key para autenticar endpoints sensibles
ARES_API_KEY=your-secret-api-key

# ===========================================
# SYSTEM
# ===========================================
TERMINAL_BACKEND=local
TERMINAL_CWD=C:/Users/YOUR_USER/Videos/Ares
TERMINAL_TIMEOUT=60
PORT=3000
